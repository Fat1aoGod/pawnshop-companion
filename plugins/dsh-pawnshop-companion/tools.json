{
  "name": "pawnshop-companion",
  "version": "0.6.0",
  "protocol_version": "0.1",
  "tools": [
    {
      "name": "companion_list_games",
      "description": "看看本机有没有开启陪玩的当铺。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "companion_connect",
      "description": "以当前会话的身份来店里陪玩；不新开模型会话。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "game_instance_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "avatar_key": {
            "type": "string",
            "enum": [
              "gpt",
              "deepseek",
              "gemini",
              "claude",
              "grok",
              "glm",
              "kimi",
              "minimax",
              "qwen"
            ]
          }
        },
        "required": [
          "game_instance_id",
          "display_name"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "companion_read_state",
      "description": "看看现场的简短文字；需要时展开已经可见的内容。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "description": "companion_connect 返回的 binding_id"
          },
          "focus": {
            "type": "string",
            "enum": [
              "scene",
              "customer",
              "counter",
              "panel",
              "devices",
              "power"
            ]
          },
          "detailed": {
            "type": "boolean"
          }
        },
        "required": [
          "binding_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "companion_read_journal",
      "description": "翻日历、看当前档的天赋/状态、阵营声望及效果、难度，或查看黑市。日历含本周和下周已公布的事件；黑市未解锁时直接告诉你。按需查看，不逐帧刷新。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "description": "companion_connect 返回的 binding_id"
          },
          "context_id": {
            "type": "string",
            "description": "最近一次现场返回的 context_id"
          },
          "action_id": {
            "type": "string",
            "pattern": "^[\\w-]{1,100}$",
            "description": "这次动作的唯一编号；查询或重试同一动作时沿用，不要重复执行"
          },
          "topic": {
            "type": "string",
            "enum": [
              "overview",
              "calendar",
              "status",
              "reputation",
              "difficulty",
              "black_market"
            ]
          }
        },
        "required": [
          "binding_id",
          "context_id",
          "action_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "companion_open_journal",
      "description": "打开游戏原生的日历、状态、声望或已解锁黑市面板，不购买升级、不改天赋。黑市打开后可用 read_journal 看当前兑换项目。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "description": "companion_connect 返回的 binding_id"
